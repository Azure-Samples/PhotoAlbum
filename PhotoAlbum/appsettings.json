{
  "FileUpload": {
    "MaxFileSizeBytes": 10485760,
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp"
    ],
    "MaxFilesPerUpload": 10,
    "UploadPath": "wwwroot/uploads"
  },
  "Admin": {
    "Username": "admin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
